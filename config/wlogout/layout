{
    "label" : "logout",
    "action" : "loginctl terminate-user $USER",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}
{
    "label" : "lock",
    "action" : "mpvpaper -l overlay -vs -o 'no-audio loop' '*' ~/.config/hypr/ultrakill.mp4 -f & sleep 0.65; hyprlock; pkill mpvpaper",
    "text": "Lock"
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
